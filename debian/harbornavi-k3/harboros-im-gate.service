[Unit]
Description=HarborOS IM Gateway Service
After=network-online.target harboros-bootstrap.service
Wants=network-online.target
Requires=harboros-bootstrap.service
Requires=harboros-service-auth-recovery.service
After=harboros-service-auth-recovery.service
RequiresMountsFor=/data
ConditionPathExists=/run/harboros/home.env

[Service]
Type=simple
UMask=0077
Environment=HARBORGATE_RUNTIME_PROFILE=k3
Environment=IM_AGENT_HOST=127.0.0.1
Environment=IM_AGENT_PORT=8787
Environment=IM_AGENT_CONTRACT_VERSION=2.0
Environment=IM_AGENT_DATA_DIR=/data/harborgate/sessions
Environment=IM_AGENT_STATE_DIR=/data/harborgate
Environment=WEIXIN_STATE_DIR=/data/harborgate/weixin
Environment=FEISHU_MAIL_TOKEN_STATE_PATH=/data/harborgate/feishu-mail-token.json
Environment=HARBORBEACON_WEB_API_URL=http://127.0.0.1:4174
Environment=HARBORGATE_DEVICE_SESSION_STATE_DIR=/data/harborgate/device-sessions
EnvironmentFile=/run/harboros/home.env
LoadCredential=gate-to-beacon-send:/etc/harboros/service-auth/gate-to-beacon.send
LoadCredential=beacon-to-gate-accept-current:/etc/harboros/service-auth/beacon-to-gate.accept-current
LoadCredential=beacon-to-gate-accept-previous:/etc/harboros/service-auth/beacon-to-gate.accept-previous
ExecStart=/usr/bin/harboros-im-gate
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/data/harborgate

[Install]
WantedBy=multi-user.target
